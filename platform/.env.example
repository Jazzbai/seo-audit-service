# Server-only setup. Site credentials and routine controls belong in the UI.
# Use URL-safe random passwords; never copy the legacy application's .env.
DB_PASSWORD=
QUEUE_PASSWORD=
ENCRYPTION_KEY=
# Required only while creating the first owner through /bootstrap. Generate a
# long random value, enter it in the setup screen, then rotate it after
# bootstrap. Never commit or share the real value.
BOOTSTRAP_TOKEN=
# Production: https://seo.example.com; APP_ADDRESS=seo.example.com; ports 80/443.
PUBLIC_URL=http://localhost:18080
APP_ADDRESS=http://:80
COOKIE_SECURE=false
HTTP_PORT=18080
HTTPS_PORT=18443
# Optional encrypted-backup profile. Keep BACKUP_KEY separate from all
# application secrets and retain it outside the server for recovery.
BACKUP_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=172800
# Optional operator-mounted secondary copy. Leave both blank for local-only
# behavior. To enable it, set BACKUP_MIRROR_DIRECTORY=/srv/backup-mirror and
# BACKUP_MIRROR_HOST_PATH to an existing writable host directory. The host
# location is not automatically off-site; that placement is an operator duty.
BACKUP_MIRROR_DIRECTORY=
BACKUP_MIRROR_HOST_PATH=
