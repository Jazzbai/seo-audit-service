# Additive site block for the EXISTING Caddy; never replace its full config.
# These ports are proposed, not verified free. See docs/SPLIT_HOST_DEPLOYMENT.md.
# Replace this documentation hostname and illustrative private address.
seo.example.com {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	@backend path /api /api/* /health
	handle @backend {
		reverse_proxy 10.20.0.10:18001 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:18080
	}
}
